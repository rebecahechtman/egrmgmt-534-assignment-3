{
  "metadata": {
    "title": "Treasury duration, term premium, and mortgage rates",
    "retrieved_date": "2026-11-09",
    "as_of_date": "2026-11-09",
    "monthly_start": "2019-01",
    "monthly_end": "2026-10",
    "monthly_observations": 94,
    "default_start_month": "2019-01",
    "default_end_month": "2025-12",
    "aggregation": "Arithmetic mean of each source's non-missing observations dated within each calendar month. Daily term premiums and Treasury yields, and weekly mortgage-rate observations, are averaged separately then joined on month. No forward-filling, interpolation, or synthetic observations. Modified duration is calculated for each daily Treasury yield and averaged within the month. November 2026 is incomplete and excluded.",
    "rate_units": "Percent per year. A difference of 1.00 in the rate fields equals one percentage point or 100 basis points.",
    "duration_units": "Years",
    "duration_method": {
      "label": "Estimated constant-maturity Treasury benchmark modified duration",
      "face_value": 100,
      "annual_coupon_percent": 4,
      "coupon_frequency": 2,
      "years_to_maturity": 10,
      "discount_yield": "FRED DGS10 / 100",
      "calculation": "20 semiannual payments. Cash flow is $2 at periods 1-19 and $102 at period 20. PV_k = CF_k / (1 + y/2)^k. Macaulay duration = sum((k/2)*PV_k)/sum(PV_k). Modified duration = Macaulay duration/(1+y/2).",
      "interpretation": "Standardized 10-year, 4% coupon benchmark repriced at each daily constant-maturity yield. It is not the measured duration or realized return of one security/CUSIP. The fixed maturity avoids aging effects across the historical comparison."
    },
